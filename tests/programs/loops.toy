// Nested loops, a long-running loop, and variables that are reset at each iteration.
fun main(): int {
    var total: int = 0;
    var i: int = 0;
    while (i < 10) {
        var j: int = 0;
        while (j < 10) { total = total + i * j; j = j + 1; }
        i = i + 1;
    }
    print(total);

    var n: int = 27;                 // the Collatz sequence of 27 has 111 steps
    var steps: int = 0;
    while (n != 1) {
        if (n % 2 == 0) { n = n / 2; } else { n = 3 * n + 1; }
        steps = steps + 1;
    }
    print(steps);

    var k: int = 0;
    while (k < 3) {
        var fresh: int;              // no value: it is 0 again at every iteration
        fresh = fresh + 1;
        print(fresh);
        k = k + 1;
    }
    return 0;
}
