// @heap 65536
// @exit 101
// @stderr out of memory
// @no-stress
// Everything stays alive, so no collection can help: the heap is really full.
struct Node { val: int; next: Node; }
fun push(head: Node, v: int): Node {
    var n: Node = new Node;
    n.val = v;
    n.next = head;
    return n;
}
fun main(): int {
    var head: Node = null;
    print(1);
    while (true) { head = push(head, 1); }
    return 0;
}
