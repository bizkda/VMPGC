// @heap 8192
// @expect-gc
// While mk(i + 1) allocates (and the GC runs), the result of mk(i) is only on the operand stack,
// and so are `items` and `k` during items[k] = mk(...). The stack maps must mark them.
struct Node { val: int; next: Node; }

fun mk(v: int): Node {
    var n: Node = new Node;
    n.val = v;
    return n;
}
fun pair(a: Node, b: Node): Node {
    a.next = b;
    return a;
}
fun main(): int {
    var total: int = 0;
    var i: int = 0;
    while (i < 2000) {
        var p: Node = pair(mk(i), mk(i + 1));
        total = total + p.val + p.next.val;
        i = i + 1;
    }
    print(total);

    var items: Node[] = new Node[50];
    var k: int = 0;
    while (k < 50) { items[k] = mk(k * 10); k = k + 1; }
    var check: int = 0;
    k = 0;
    while (k < 50) { check = check + items[k].val; k = k + 1; }
    print(check);
    return 0;
}
