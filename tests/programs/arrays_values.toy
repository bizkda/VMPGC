// @heap 32768
// @expect-gc
// Arrays of ints (no references inside) are allocated again and again; one array must keep its content.
fun fill(a: int[], n: int, seed: int): int {
    var i: int = 0;
    while (i < n) { a[i] = seed + i; i = i + 1; }
    return 0;
}
fun total(a: int[], n: int): int {
    var sum: int = 0;
    var i: int = 0;
    while (i < n) { sum = sum + a[i]; i = i + 1; }
    return sum;
}
fun main(): int {
    var keep: int[] = new int[200];
    fill(keep, 200, 5);
    var round: int = 0;
    var acc: int = 0;
    while (round < 300) {
        var tmp: int[] = new int[100];
        fill(tmp, 100, round);
        acc = acc + total(tmp, 100);
        round = round + 1;
    }
    print(total(keep, 200));
    print(acc);
    return 0;
}
