struct Node { val: int; next: Node; }

fun push(head: Node, v: int): Node {
    var n: Node = new Node;
    n.val = v;
    n.next = head;
    return n;
}

fun main(): int {
    var list: Node = null;
    var i: int = 0;
    while (i < 1000000) {
        list = push(null, i);   // old lists become garbage
        i = i + 1;
    }
    print(list.val);
    return 0;
}
