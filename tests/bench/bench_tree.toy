// A tree of 16383 nodes stays alive while 100 trees of 4095 nodes are built and dropped.
struct Tree { left: Tree; right: Tree; key: int; }
fun build(depth: int, key: int): Tree {
    if (depth == 0) { return null; }
    var node: Tree = new Tree;
    node.key = key;
    node.left = build(depth - 1, key * 2);
    node.right = build(depth - 1, key * 2 + 1);
    return node;
}
fun sum(t: Tree): int {
    if (t == null) { return 0; }
    return t.key + sum(t.left) + sum(t.right);
}
fun main(): int {
    var kept: Tree = build(14, 1);
    var round: int = 0;
    var checksum: int = 0;
    while (round < 100) {
        var garbage: Tree = build(12, round + 1);
        checksum = checksum + sum(garbage) % 1000;
        round = round + 1;
    }
    print(sum(kept));
    print(checksum);
    return 0;
}
